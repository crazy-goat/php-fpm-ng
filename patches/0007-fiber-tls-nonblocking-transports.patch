+#ifdef HAVE_FPMNG_FIBER_TLS
+/* Fiber TLS transports. The factories below return streams whose ops point
+ * DIRECTLY at php_openssl_socket_ops; the fiber wrapper goes on lazily on the
+ * first call from a request fiber (fpm_fiber_tls_wrap_ops_once). That keeps
+ * the upstream ops identity for everything that is not a fiber request —
+ * including accepted client sockets, which inherit the listener's ops. */
+static php_stream_transport_factory fpm_fiber_tls_orig[7];
+static const char * const fpm_fiber_tls_names[7] = {
+	"ssl", "sslv3", "tls", "tlsv1.0", "tlsv1.1", "tlsv1.2", "tlsv1.3"
+};
+
+/* One zlog about a refused TLS configuration per process, not per attempt:
+ * a looping connect would otherwise flood the worker log. */
+static bool fpm_fiber_tls_refusal_logged = false;
+
+static php_stream *fpm_fiber_tls_factory(const char *proto, size_t protolen,
+		const char *resourcename, size_t resourcenamelen,
+		const char *persistent_id, int options, int flags,
+		struct timeval *timeout,
+		php_stream_context *context STREAMS_DC)
+{
+	size_t i;
+	php_stream *stream;
+
+	/* Server-side TLS over these transports is refused, not silently degraded:
+	 * an accepted client is allocated with the LISTENER's ops
+	 * (php_openssl_tcp_sockop_accept), which here would be our fiber wrapper
+	 * whose close() would pefree() a struct it does not own. This does not
+	 * affect the fpm-ng HTTP gateway, which terminates TLS in libevent
+	 * (sapi/fpmng/fpm/fpm_http_tls.c), never through stream transports. */
+	if ((flags & (STREAM_XPORT_SERVER | STREAM_XPORT_BIND)) && fpm_pool_fiber_can_wait()) {
+		if (!fpm_fiber_tls_refusal_logged) {
+			fpm_fiber_tls_refusal_logged = true;
+			zlog(ZLOG_NOTICE, "[pool %s] fiber: refused a server-side TLS transport "
+				"(ssl/tls listen): accepted sockets would inherit the wrapper ops. "
+				"Terminate TLS at the HTTP gateway (http.tls_cert) instead",
+				fpm_coop_pool_name());
+		}
+		php_error_docref(NULL, E_WARNING,
+			"server-side TLS transports are not supported with pool.executor = fiber: "
+			"accepted sockets would inherit the wrapper ops; terminate TLS at the HTTP "
+			"gateway (http.tls_cert) instead");
+		return NULL;
+	}
+
+	for (i = 0; i < 7; i++) {
+		if (strncmp(proto, fpm_fiber_tls_names[i], protolen) == 0) {
+			break;
+		}
+	}
+	if (i == 7 || !fpm_fiber_tls_orig[i]) {
+		return NULL;	/* a proto we did not capture: fail as "transport not found" */
+	}
+
+	stream = fpm_fiber_tls_orig[i](proto, protolen, resourcename, resourcenamelen,
+		persistent_id, options, flags, timeout, context STREAMS_REL_CC);
+
+	/* allow_blocking => true asks for a stream that must never be wrapped;
+	 * under this executor that means a connect that can stop every request in
+	 * the process, so it is refused loudly (the persistent-connection refusal
+	 * in fpm_pool_fiber_xport.c is the precedent). */
+	if (stream && fpm_pool_fiber_can_wait() && stream->ops == &php_openssl_socket_ops &&
+			PHP_STREAM_CONTEXT(stream)) {
+		zval *val = php_stream_context_get_option(PHP_STREAM_CONTEXT(stream), "ssl", "allow_blocking");
+
+		if (val && zend_is_true(val)) {
+			if (!fpm_fiber_tls_refusal_logged) {
+				fpm_fiber_tls_refusal_logged = true;
+				zlog(ZLOG_NOTICE, "[pool %s] fiber: refused a TLS connection with "
+					"ssl.allow_blocking = true: a blocking TLS stream would stop every "
+					"request in this process. Drop the option (see docs/fiber_errors.md)",
+					fpm_coop_pool_name());
+			}
+			php_error_docref(NULL, E_WARNING,
+				"ssl.allow_blocking = true is not supported with pool.executor = fiber: "
+				"a blocking TLS stream would stop every request in this process "
+				"(see docs/fiber_errors.md); drop the option");
+			php_stream_close(stream);
+			return NULL;
+		}
+	}
+	return stream;
+}
+
+void fpm_fiber_tls_xport_install(void)
+{
+	HashTable *xports = php_stream_xport_get_hash();
+	size_t i, n = 0;
+
+	for (i = 0; i < 7; i++) {
+		fpm_fiber_tls_orig[i] = zend_hash_str_find_ptr(xports,
+			fpm_fiber_tls_names[i], strlen(fpm_fiber_tls_names[i]));
+		if (fpm_fiber_tls_orig[i] == php_openssl_ssl_socket_factory) {
+			php_stream_xport_register(fpm_fiber_tls_names[i], fpm_fiber_tls_factory);
+			n++;
+		}
+	}
+	/* Explicit about what got wrapped, like the "stream transports hooked"
+	 * line for tcp/unix in fpm_pool_fiber_xport.c. n < 7 means ext/openssl's
+	 * MINIT registrations were replaced by something else after MINIT — say
+	 * so, because TLS then stays blocking with no other trace. */
+	zlog(n == 7 ? ZLOG_DEBUG : ZLOG_WARNING,
+		"[pool %s] fiber: stream transports hooked: ssl/tls=%zu/7%s",
+		fpm_coop_pool_name(), n,
+		n == 7 ? "" : " (unexpected transport owner; TLS stays blocking)");
+}
+#endif /* HAVE_FPMNG_FIBER_TLS */
