{
    "name": "php-fpm-ng/symfony-fiber-probe",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "doctrine/doctrine-bundle": "3.3.1",
        "doctrine/doctrine-migrations-bundle": "4.0.1",
        "doctrine/orm": "3.6.8",
        "predis/predis": "3.6.0",
        "symfony/cache": "8.1.6",
        "symfony/console": "8.1.6",
        "symfony/dotenv": "8.1.6",
        "symfony/flex": "2.11.0",
        "symfony/form": "8.1.6",
        "symfony/framework-bundle": "8.1.6",
        "symfony/messenger": "8.1.6",
        "symfony/security-bundle": "8.1.6",
        "symfony/twig-bundle": "8.1.2",
        "symfony/validator": "8.1.6",
        "symfony/yaml": "8.1.6",
        "twig/twig": "3.28.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true,
        "platform-check": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
