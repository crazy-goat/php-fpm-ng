     /**
+     * The first port of this worker's 200-port block, one below the first port
+     * getPort() hands out.
+     *
+     * Issue #674 (php-fpm-ng) moves the whole block by FPMNG_PHPT_PORT_SHIFT,
+     * which build/run-fpmng-phpt.sh picks per run from a range nothing listens
+     * on. Unset or 0 moves nothing.
+     *
+     * Issue #625 (php-fpm-ng) replaces the historical 9000 origin with
+     * FPMNG_PHPT_PORT_BASE instead of shifting it: a base of B makes this
+     * run's block B+1 .. B+200 whatever B is, which is what lets a lane of
+     * 1000 ports hold a whole suite (build/run-fpmng-phpt.sh lays the rest of
+     * the lane out and says so). A base wins over a shift; the runner refuses
+     * to set both.
+     */
+    private function portBase(): int
+    {
+        $worker = (int) getenv('TEST_PHP_WORKER');
+        $lane   = getenv('FPMNG_PHPT_PORT_BASE');
+
+        return $lane === false || $lane === ''
+            ? 9000 + PHP_INT_SIZE - 1 + $worker * 200 + (int) getenv('FPMNG_PHPT_PORT_SHIFT')
+            : (int) $lane + $worker * 200;
+    }
