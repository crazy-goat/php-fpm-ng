{
    "name": "php-fpm-ng/laravel-probe",
    "description": "Laravel probe application for php-fpm-ng fiber executor measurements",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.3",
        "laravel/framework": "13.30.1",
        "predis/predis": "3.6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
