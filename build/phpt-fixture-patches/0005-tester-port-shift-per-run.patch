+    /**
+     * Issue #674 (php-fpm-ng): a gateway pool opens the operator endpoint on
+     * 127.0.0.1:9253 unless it names another address, and that address is global
+     * to the host, so a master of another run (or another person) that holds it
+     * fails every gateway test. Give each gateway pool without an explicit
+     * operator.status_listen / operator.metrics_listen one of the run's own: the
+     * last port of this worker's block, which getPort() never reaches, moved by
+     * FPMNG_PHPT_PORT_SHIFT like every other port. Pools that name an address
+     * keep it, and so does every pool of another type.
+     */
+    private function moveOperatorDefault(string $config): string
+    {
+        $port   = 9000 + PHP_INT_SIZE - 1 + 199 + 200 * (int) getenv('TEST_PHP_WORKER')
+            + (int) getenv('FPMNG_PHPT_PORT_SHIFT');
+        $chunks = preg_split('/^(?=\[)/m', $config);
+        foreach ($chunks as $i => $chunk) {
+            if (
+                ! preg_match('/^\[(?!global\])[^\]\n]+\][^\n]*\n/', $chunk, $header)
+                || ! preg_match('/^\s*pool\.type\s*=\s*gateway\s*$/m', $chunk)
+            ) {
+                continue;
+            }
+            $add = '';
+            foreach (['status', 'metrics'] as $kind) {
+                if ( ! preg_match('/^\s*operator\.' . $kind . '_listen\s*=/m', $chunk)) {
+                    $add .= "operator.{$kind}_listen = 127.0.0.1:$port\n";
+                }
+            }
+            $chunks[$i] = $header[0] . $add . substr($chunk, strlen($header[0]));
+        }
+
+        return implode('', $chunks);
     }
 
