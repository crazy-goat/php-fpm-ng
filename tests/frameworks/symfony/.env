APP_ENV=dev
APP_DEBUG=1
APP_SECRET=fpmng-symfony-probe-secret
DATABASE_URL=mysql://root:root@127.0.0.1:13306/fpmng_symfony_default?serverVersion=8.4&charset=utf8mb4
REDIS_DSN=redis://127.0.0.1:16379/15
REDIS_PREFIX=fpmng:symfony:default:
SESSION_COOKIE_NAME=FPMNGSESSID
DEFAULT_URI=http://127.0.0.1

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
