--- a/sapi/fpmng/tests/gh23288-opcache-interned-strings-buffer-pool.phpt
+++ b/sapi/fpmng/tests/gh23288-opcache-interned-strings-buffer-pool.phpt
@@ -3,7 +3,18 @@
 --EXTENSIONS--
 opcache
 --SKIPIF--
-<?php include "skipif.inc"; ?>
+<?php
+include "skipif.inc";
+/* Issue #991 (php-fpm-ng): the opcache fix this test checks (GH-23288,
+ * accel_startup_ok in OnUpdateInternedStringsBuffer) is in libphp, not in the
+ * SAPI. A libphp older than php-8.5.11 fails it, so it is a skip there, not a
+ * deviation. PHP_VERSION_ID is the version of the CLI that runs the test; in
+ * CI build/ci-install-deps.sh takes the CLI and libphp from the same php8.5
+ * distribution packages, so it is the libphp that php-fpm-ng links. */
+if (PHP_VERSION_ID < 80511) {
+    die("skip needs libphp >= 8.5.11 (opcache interned_strings_buffer fix)");
+}
+?>
 --FILE--
