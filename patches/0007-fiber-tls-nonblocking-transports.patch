+/* Wait for the socket instead of php_pollfd_for: suspend the fpm-ng request
+ * fiber on the scheduler when we can (in a request fiber), poll exactly as
+ * upstream when we cannot (CLI, classic executor, nested user fiber). */
+static int fpm_fiber_tls_wait(php_socket_t fd, int events, struct timeval *timeout)
+{
+	int r;
+
+	if (fpm_pool_fiber_can_wait()) {
+		return fpm_pool_fiber_wait_fd(fd,
+			(events & (POLLIN | POLLPRI)) ? EV_READ : EV_WRITE, timeout);
+	}
+	do {
+		r = php_pollfd_for(fd, events, timeout);
+	} while (r < 0 && errno == EINTR);
+	return r;
+}
+
+/* The ssl/tls factories (bottom of this file) return streams whose ops point
+ * DIRECTLY at php_openssl_socket_ops — no wrapper — so accepted client
+ * streams (allocated with the listener's ops, php_openssl_tcp_sockop_accept)
+ * and any code comparing against the table behave exactly as upstream. The
+ * fiber wrapper goes on lazily, on the first call from a request fiber, and
+ * then stays: the stream belongs to that request until close. */
+static void fpm_fiber_tls_wrap_ops_once(php_stream *stream)
+{
+	if (fpm_pool_fiber_can_wait() && stream->ops == &php_openssl_socket_ops) {
+		stream->ops = fpm_fiber_xport_wrap(&php_openssl_socket_ops);
+	}
+}
